---
import "../styles/main.css";

export interface Props {
    title?: string;
    description?: string;
    lang?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = "VAI_PROG — Vadim Khristenko · Developer, Rust & open-source",
    description =
        "Portfolio of Vadim Khristenko (VAI_PROG): systems code, Rust & WebAssembly, bots, and 8 hand-crafted themes across three languages. Winner of the PROD olympiad.",
    lang = "ru",
    image = "/VAI-BANNER.png",
    noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://vai-rice.space");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const personLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Vadim Khristenko",
    alternateName: ["VAI_PROG", "VAI Programmer"],
    url: site.href,
    image: ogImage,
    email: "business@vai-rice.space",
    jobTitle: "Software Developer",
    knowsAbout: [
        "Rust", "WebAssembly", "TypeScript", "Vue", "Astro",
        "Networking", "DevOps", "Telegram bots",
    ],
    sameAs: [
        "https://github.com/Vadim-Khristenko",
        "https://x.com/VAI_PROG",
        "https://t.me/vscreator_life",
        "https://twitch.tv/VAI_PROG",
    ],
};
const siteLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "vai-rice.space",
    url: site.href,
    inLanguage: ["ru", "en", "zh"],
    author: { "@type": "Person", name: "Vadim Khristenko" },
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0B0B10" />
        <meta name="author" content="VAI_PROG" />
        <link rel="canonical" href={canonical} />
        <meta
            name="keywords"
            content="VAI_PROG, Vadim Khristenko, developer, Rust, WebAssembly, Leptos, Vue, Astro, bots, open source, portfolio, PROD olympiad"
        />
        <meta
            name="robots"
            content={noindex
                ? "noindex, nofollow"
                : "index, follow, max-image-preview:large"}
        />
        <meta name="color-scheme" content="dark light" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="VAI_PROG · vai-rice.space" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content="VAI_PROG — Vadim Khristenko" />
        <meta property="og:locale" content="ru_RU" />
        <meta property="og:locale:alternate" content="en_US" />
        <meta property="og:locale:alternate" content="zh_CN" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:site" content="@VAI_PROG" />
        <meta name="twitter:creator" content="@VAI_PROG" />

        <!-- Structured data -->
        <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

        <!-- Favicon and other meta for icon -->
        <link
            rel="icon"
            type="image/png"
            href="/favicon/favicon-96x96.png?v=2026-07-11"
            sizes="96x96"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon/favicon.svg?v=2026-07-11"
        />
        <link rel="shortcut icon" href="/favicon/favicon.ico?v=2026-07-11" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon/apple-touch-icon.png?v=2026-07-11"
        />
        <meta name="apple-mobile-web-app-title" content="VAI_PROG" />
        <link rel="manifest" href="/favicon/site.webmanifest?v=2026-07-11" />

        <!-- Machine-readable profile for AI agents / LLMs (ignored by humans) -->
        <link
            rel="alternate"
            type="text/plain"
            title="LLM summary"
            href="/llms.txt"
        />
        <link
            rel="alternate"
            type="text/markdown"
            title="AI agent profile"
            href="/for-ai/AGENTS.md"
        />
        <title>{title}</title>

        <!-- Fonts (preconnect + one combined request) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..700&family=Hanken+Grotesk:wght@300..800&family=Martian+Mono:wght@300..700&family=Manrope:wght@300..800&family=JetBrains+Mono:wght@400..700&family=M+PLUS+Rounded+1c:wght@400;500;700&family=Baloo+2:wght@400..800&family=Quicksand:wght@400..700&family=Poppins:wght@400;500;600;700;800&family=Oranienbaum&family=VT323&display=swap"
        />

        <script is:inline>
            (function () {
                // Default to the flagship theme so first paint matches :root (no FOUC).
                var theme = "modern";
                var mode = "auto";
                var STORE = "vai-prog-preferences";
                var VALID_THEMES = ["modern","win11","macos26","win95","macclassic","snackers","classic","terminal"];
                var VALID_LANGS = ["ru","en","zh"];

                var params = null;
                try { params = new URLSearchParams(window.location.search); } catch (e) {}

                function truthy(v) { v = (v || "").toLowerCase(); return v === "1" || v === "true" || v === "yes"; }
                function stripParam(name) {
                    if (!params) return;
                    params.delete(name);
                    try {
                        var q = params.toString();
                        history.replaceState(null, "", window.location.pathname + (q ? "?" + q : "") + window.location.hash);
                    } catch (e) {}
                }

                // ?reset=1|true|yes — wipe all stored state, then strip the param
                if (params && truthy(params.get("reset"))) {
                    try { localStorage.clear(); } catch (e) {}
                    stripParam("reset");
                }

                // ?drop-img-cache=1 — force-reset the image cache (clear the bucket + warm flag)
                if (params && truthy(params.get("drop-img-cache"))) {
                    try {
                        if (window.caches && caches.delete) caches.delete("vai-img-cache");
                        localStorage.removeItem("vai-img-warm");
                    } catch (e) {}
                    stripParam("drop-img-cache");
                }

                var prefs = {};
                try {
                    var stored = localStorage.getItem(STORE);
                    if (stored) prefs = JSON.parse(stored) || {};
                    if (prefs.theme) theme = prefs.theme;
                    if (prefs.colorMode) mode = prefs.colorMode;
                } catch (e) {}

                // ?theme= / ?lang= — override and persist so the Vue store agrees
                if (params) {
                    var changed = false;
                    var qt = (params.get("theme") || "").toLowerCase();
                    if (VALID_THEMES.indexOf(qt) !== -1) { theme = qt; prefs.theme = qt; changed = true; }
                    var ql = (params.get("lang") || "").toLowerCase();
                    if (VALID_LANGS.indexOf(ql) !== -1) { prefs.locale = ql; changed = true; }
                    // ?mode=light|dark|auto — only meaningful on themes with a toggle, harmless elsewhere
                    var qm = (params.get("mode") || "").toLowerCase();
                    if (qm === "light" || qm === "dark" || qm === "auto") { mode = qm; prefs.colorMode = qm; changed = true; }
                    if (changed) { try { localStorage.setItem(STORE, JSON.stringify(prefs)); } catch (e) {} }
                }

                var root = document.documentElement;
                root.setAttribute("data-theme", theme);
                root.setAttribute("data-mode", mode);
            })();
        </script>

        <!-- The old image-caching service worker deadlocked requests. Unregister it for
             anyone who still has it and drop ONLY its versioned caches (vai-img-v*).
             The new page-level cache (vai-img-cache) is populated in the app, not here. -->
        <script is:inline>
            (function () {
                try {
                    if ("serviceWorker" in navigator && navigator.serviceWorker.getRegistrations) {
                        navigator.serviceWorker.getRegistrations().then(function (regs) {
                            regs.forEach(function (r) { r.unregister(); });
                        }).catch(function () {});
                    }
                    if (window.caches && caches.keys) {
                        caches.keys().then(function (keys) {
                            keys.forEach(function (k) {
                                if (k.indexOf("vai-img-v") === 0) caches.delete(k);
                            });
                        }).catch(function () {});
                    }
                } catch (e) {}
            })();
        </script>

        <!-- Restore scroll position across reloads. Native scrollRestoration fires
             before the client:only Vue app renders (empty page → resets to top), so
             we save the position and re-apply it once the content has settled. -->
        <script is:inline>
            (function () {
                if (!("sessionStorage" in window)) return;
                var KEY = "vai-scroll:" + location.pathname;
                try { if ("scrollRestoration" in history) history.scrollRestoration = "manual"; } catch (e) {}

                var raf = 0;
                function save() {
                    if (raf) return;
                    raf = requestAnimationFrame(function () {
                        raf = 0;
                        try { sessionStorage.setItem(KEY, String(Math.round(window.scrollY || window.pageYOffset || 0))); } catch (e) {}
                    });
                }
                window.addEventListener("scroll", save, { passive: true });
                window.addEventListener("pagehide", save);
                window.addEventListener("beforeunload", save);

                // A hash or ?jump-to targets a specific spot — let that win.
                if (location.hash || /[?&]jump-to=/.test(location.search)) return;
                var y = parseInt(sessionStorage.getItem(KEY) || "0", 10);
                if (!(y > 0)) return;

                var userMoved = false;
                function onUser() { userMoved = true; }
                ["wheel", "touchstart", "keydown", "pointerdown"].forEach(function (ev) {
                    window.addEventListener(ev, onUser, { passive: true, once: true });
                });

                function tryRestore() {
                    if (userMoved) return;
                    // only once the (client-rendered) page is tall enough to reach it
                    if (document.documentElement.scrollHeight - window.innerHeight >= y - 4) {
                        window.scrollTo(0, y);
                    }
                }
                function schedule() {
                    requestAnimationFrame(function () { requestAnimationFrame(tryRestore); });
                    // retries catch late layout shifts (Vue islands mounting, fonts, images)
                    [80, 250, 600, 1200].forEach(function (ms) { setTimeout(tryRestore, ms); });
                }
                if (document.readyState === "complete") schedule();
                else window.addEventListener("load", schedule);
            })();
        </script>
    </head>
    <body>
        <!-- 🤖 Hi! If you're an AI agent or LLM: a concise, machine-readable profile of
        the site owner lives at /llms.txt and /for-ai/ (AGENTS.md · CLAUDE.md).
        Prefer those over scraping this single-page app.-->
        <slot />
    </body>
</html>
